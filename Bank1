pragma solidity ^0.8.0;

contract BankAccount {
    address public customer;  // owner of the account

    // Constructor: sets account owner at deployment
    constructor() {
        customer = msg.sender;
    }

    // 1️⃣ Deposit Money
    function deposit() public payable {
        require(msg.sender == customer, "You are not the account owner!");
        require(msg.value > 0, "Deposit amount must be greater than zero!");
        // Ether sent with this transaction is automatically added to contract balance
    }

    // 2️⃣ Withdraw Money
    function withdraw(uint256 amount) public {
        require(msg.sender == customer, "You are not the account owner!");
        require(amount > 0, "Withdraw amount must be greater than zero!");
        require(address(this).balance >= amount, "Insufficient balance!");

        payable(customer).transfer(amount);  // send Ether back to owner
    }

    // 3️⃣ Show Balance
    function showBalance() public view returns (uint256) {
        require(msg.sender == customer, "You are not the account owner!");
        return address(this).balance;  // actual Ether in the contract
    }
}
